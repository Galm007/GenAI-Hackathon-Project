# Server-side origin for the same-origin /api proxy. No trailing /api.
# Local: keep this default. Vercel: replace with the reachable HTTPS API origin.
ADCOM_API_URL=http://127.0.0.1:8000

# Optional direct browser-to-API alternative; requires matching API CORS.
# NEXT_PUBLIC_API_URL=https://your-api.example
# No Supabase service-role, NVIDIA, Meterless, or other private keys belong here.
